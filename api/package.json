{
  "name": "diginomic-fest-api",
  "version": "1.0.0",
  "description": "Backend API end-to-end untuk Digiconomic Fest 2027 (Node.js ESM, PostgreSQL 16, Docker Ready)",
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "seed": "node db/seed.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "test:security": "node --test tests/security.test.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
