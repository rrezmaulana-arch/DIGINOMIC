{
  "name": "digiconomic-fest-2027-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo Digiconomic Fest 2027 (web frontend React + api backend Node.js/PostgreSQL + deploy Docker)",
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "dev:web": "npm --workspace=web run dev",
    "build:web": "npm --workspace=web run build",
    "dev:api": "npm --workspace=api run dev",
    "start:api": "npm --workspace=api run start",
    "seed:api": "npm --workspace=api run seed",
    "test:api": "npm --workspace=api test",
    "docker:dev": "docker compose -f deploy/docker-compose.dev.yml up --build",
    "docker:prod": "docker compose -f deploy/docker-compose.yml up -d --build"
  }
}
